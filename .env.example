# Docker Compose Environment Variables
# Copy this file to .env and fill in the values before running docker-compose up.

# SQL Server SA credentials
SA_PASSWORD=<your-strong-sql-server-password>

# Connection strings for each service
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=QuickApp;User Id=sa;Password=<your-sa-password>;TrustServerCertificate=true;MultipleActiveResultSets=true
